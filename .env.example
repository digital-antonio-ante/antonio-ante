# ─── Sanity.io (required) ─────────────────────────────────────────────────────
PUBLIC_SANITY_PROJECT_ID=your_project_id_here
PUBLIC_SANITY_DATASET=production

# ─── Sanity.io (write token — requerido para guardar mensajes de contacto) ───
# En Cloudflare va como secret: `npx wrangler secret put SANITY_API_TOKEN`.
# Necesita permiso de escritura (Editor) en el dataset.
# SANITY_API_TOKEN=your_token_here

# ─── Google Analytics 4 (opcional) ───────────────────────────────────────────
# Measurement ID de la propiedad oficial del GAD (ej. G-XXXXXXXXXX).
# Si se deja vacío, GA4 NO se inyecta. Se lee en tiempo de build.
# PUBLIC_GA4_ID=

# ─── Environment ─────────────────────────────────────────────────────────────
# Set to "production" in production build. Any other value triggers noindex.
APP_ENV=development
