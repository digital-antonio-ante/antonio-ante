---
/**
 * CantonMapSVG.astro — Mapa interactivo del Cantón Antonio Ante.
 *
 * El SVG del diseñador ("Mapa antonio ante.svg") trae las 6 parroquias como
 * paths vectoriales reales, así que aquí NO hay capa de polígonos aproximados:
 * **el contorno que se pinta es el mismo que recibe el clic**. Un solo path por
 * parroquia hace de relleno, de borde y de zona clicable.
 *
 * La geometría y los degradados vienen de `canton-map-geometry.ts` (generado por
 * `scripts/build-canton-map.mjs`); las fotos de fondo y las viñetas ilustradas,
 * de /images/mapa/*.webp — fuera del SVG, porque incrustadas en base64 pesaban
 * 28 MB en el elemento LCP de la home.
 *
 * ── Por qué hay máscaras ────────────────────────────────────────────────────
 * Los contornos del diseño NO teselan el cantón: se solapan en bandas de hasta
 * ~15 unidades a lo largo de cada frontera (Atuntaqui pisa un 9,6 % de Chaltura).
 * En el archivo del diseñador eso no se nota porque el relleno opaco de quien va
 * después tapa a quien va antes, borde incluido — pero en cuanto una parroquia se
 * resalta, su trazo grueso vive dentro del territorio del vecino y aparece medio
 * comido: dos líneas paralelas donde debería haber una.
 *
 * `coveredBy` trae, por parroquia, quiénes se pintan después. Con eso cada una se
 * recorta a su región REALMENTE visible, y entonces las seis teselan: ninguna
 * pinta dentro de otra, ningún trazo queda huérfano y el resalte de la
 * seleccionada no puede ensuciarse.
 *
 * El JS de canton-hero.ts / canton-map-widget.ts detecta `data-select-parish`
 * — mismo contrato que antes, sin cambios.
 */
import { PARISHES } from '../data/parishes';
import {
  MAP_VIEWBOX,
  MAP_ASPECT_RATIO,
  MAP_UNITS_PER_KM,
  MAP_GRADIENTS,
  PARISH_GEOMETRY,
} from '../data/canton-map-geometry';

/** Prefijo de ids: el SVG va incrustado en el HTML y sus ids son globales. */
const UID = 'aa-map';

const [vbX, vbY, vbW, vbH] = MAP_VIEWBOX.split(' ').map(Number);

const shapeId = (id: string) => `${UID}-shape-${id}`;
/**
 * La máscara DEFINE la región visible, no solo le resta vecinos: es también lo que
 * confina la fotografía de fondo, que es un rectángulo mucho mayor que la
 * parroquia. Por eso la llevan las seis, incluida la última del orden de pintado,
 * a la que no le tapa nadie.
 */
const maskFor = (p: (typeof PARISH_GEOMETRY)[number]) => `url(#${UID}-visible-${p.id})`;

/**
 * Contornos que hay que trazar para dibujar el borde de la región VISIBLE de una
 * parroquia. No basta con el suyo: donde un vecino posterior le come territorio, la
 * frontera que se ve es el contorno DEL VECINO. Trazando ambos y recortando el
 * resultado con la máscara sale el perímetro completo y ni un milímetro de más —
 * lo que caiga fuera de la región visible lo borra la propia máscara.
 */
const boundaryOf = (p: (typeof PARISH_GEOMETRY)[number]) => [p.id, ...p.coveredBy];

/**
 * NO reordenar `PARISH_GEOMETRY`: viene en el orden de pintado del diseñador, y
 * ese orden es el que resuelve cada banda de solape. Como el path pintado es el
 * mismo que recibe el clic, y el navegador entrega la pulsación al elemento de
 * encima, respetarlo es lo que mantiene alineado lo que se ve con lo que se
 * selecciona.
 *
 * Efecto colateral asumido: el orden de tabulación es el del diseño, no el de la
 * tira de tarjetas. Cada zona lleva su aria-label, así que sigue siendo navegable.
 */

/** Rosa de los vientos y escala gráfica, sobre el margen libre del lienzo. */
const compass = { x: vbX + vbW * 0.06, y: vbY + vbH * 0.06 };
const scaleBar = { x: vbX + vbW * 0.03, y: vbY + vbH * 0.965, km: 2 };
const scaleBarWidth = scaleBar.km * MAP_UNITS_PER_KM;
---

<div class="map-root" style={`--map-aspect: ${MAP_ASPECT_RATIO};`}>
  <svg
    class="canton-svg"
    viewBox={MAP_VIEWBOX}
    preserveAspectRatio="xMidYMid meet"
    xmlns="http://www.w3.org/2000/svg"
    role="group"
    aria-label="Mapa del Cantón Antonio Ante — sus seis parroquias son seleccionables"
  >
    <defs>
      <!-- Geometría declarada una sola vez; todo lo demás la referencia con <use> -->
      {PARISH_GEOMETRY.map((p) => <path id={shapeId(p.id)} d={p.d} />)}

      <!-- Degradados de relleno del diseño original -->
      {
        MAP_GRADIENTS.map((g) => (
          <linearGradient
            id={`${UID}-grad-${g.id}`}
            x1={g.x1}
            y1={g.y1}
            x2={g.x2}
            y2={g.y2}
            gradientUnits="userSpaceOnUse"
          >
            {g.stops.map((s) => (
              <stop offset={s.offset} stop-color={s.color} />
            ))}
          </linearGradient>
        ))
      }

      {
        PARISH_GEOMETRY.map((p) => (
          <>
            {/* Región visible = contorno propio MENOS quienes se pintan después */}
            <mask
              id={`${UID}-visible-${p.id}`}
              maskUnits="userSpaceOnUse"
              x={vbX}
              y={vbY}
              width={vbW}
              height={vbH}
            >
              <use href={`#${shapeId(p.id)}`} fill="#fff" />
              {p.coveredBy.map((other) => (
                <use href={`#${shapeId(other)}`} fill="#000" />
              ))}
            </mask>
            {/* Sombra proyectada del rótulo — color propio de cada parroquia */}
            <filter id={`${UID}-shadow-${p.id}`} x="-25%" y="-25%" width="150%" height="150%">
              <feOffset dx="2" dy="4" />
              <feGaussianBlur result="blur" stdDeviation="2" />
              <feFlood flood-color={p.shadowColor} flood-opacity="0.61" />
              <feComposite in2="blur" operator="in" />
              <feComposite in="SourceGraphic" />
            </filter>
          </>
        ))
      }
    </defs>

    <!-- ── Sombra del cantón ──────────────────────────────────────────────────
         La silueta del diseño, reconstruida gratis: la unión de las 6 parroquias
         ES el contorno del cantón, así que basta con re-referenciarlas y dejar
         que el filtro las use como alfa. Queda entera bajo los rellenos; lo único
         que se ve de esta capa es el desenfoque que asoma por fuera. -->
    <g class="map-shadow" aria-hidden="true">
      {PARISH_GEOMETRY.map((p) => <use href={`#${shapeId(p.id)}`} />)}
    </g>

    <!-- ── Una parroquia = un grupo clicable ─────────────────────────────── -->
    {
      PARISH_GEOMETRY.map((p) => {
        const parish = PARISHES[p.id];
        return (
          <g
            class="parish-zone"
            data-select-parish={p.id}
            style={`--pc: ${parish.color}; --label-size: ${p.label.fontSize}px;`}
            role="button"
            tabindex="0"
            aria-label={`Seleccionar parroquia ${parish.name}`}
          >
            {/* Todo lo geométrico va recortado a la región visible. El rótulo y la
                viñeta se quedan fuera: son marcas, no territorio, y recortarlas
                las decapitaría contra la frontera. */}
            <g class="parish-body" mask={maskFor(p)}>
              <use class="parish-fill" href={`#${shapeId(p.id)}`} fill={`url(#${UID}-grad-${p.gradientId})`} />
              {/* La foto no necesita clip propio: la máscara del grupo ya la
                  confina, y `pointer-events: none` impide que su rectángulo
                  se coma los clics dirigidos al contorno. */}
              <image
                class="parish-texture"
                href={p.texture.src}
                width={p.texture.width}
                height={p.texture.height}
                transform={p.texture.transform}
                aria-hidden="true"
              />
              {/* Realce de hover/foco: al vivir dentro de la máscara, no puede
                  desbordar hacia el vecino por mucho que se engorde. */}
              <g class="parish-ring-glow">
                {boundaryOf(p).map((id) => (
                  <use href={`#${shapeId(id)}`} />
                ))}
              </g>
              <g class="parish-ring">
                {boundaryOf(p).map((id) => (
                  <use href={`#${shapeId(id)}`} />
                ))}
              </g>
            </g>
            <image
              class="parish-icon"
              href={p.icon.src}
              x={p.icon.x}
              y={p.icon.y}
              width={p.icon.width}
              height={p.icon.height}
              aria-hidden="true"
            />
            <text
              class="parish-label"
              x={p.label.x}
              y={p.label.y}
              text-anchor="middle"
              filter={`url(#${UID}-shadow-${p.id})`}
              aria-hidden="true"
            >
              {p.label.lines.map((line, i) => (
                <tspan x={p.label.x} dy={i === 0 ? 0 : p.label.lineHeight}>
                  {line}
                </tspan>
              ))}
            </text>
          </g>
        );
      })
    }

    <!-- ── Halo de la parroquia seleccionada ──────────────────────────────────
         Va en su propia capa, la última del documento, para que el brillo salga
         entero: emitido desde dentro de una zona, el relleno de las parroquias
         posteriores se comería justo la mitad que da a tierra adentro.

         El anillo va enmascarado (nunca invade al vecino) y el resplandor lo pone
         un filtro en el grupo de FUERA, que se aplica al resultado ya recortado y
         por eso sí puede desbordar. Lleva `data-select-parish`, así que el mismo
         JS que marca las zonas lo enciende sin tocar una línea. -->
    <g class="halo-layer" aria-hidden="true">
      {
        PARISH_GEOMETRY.map((p) => (
          <g
            class="parish-halo"
            data-select-parish={p.id}
            style={`--pc: ${PARISHES[p.id].color};`}
          >
            <g mask={maskFor(p)}>
              <g class="halo-glow">
                {boundaryOf(p).map((id) => (
                  <use href={`#${shapeId(id)}`} />
                ))}
              </g>
              <g class="halo-ring">
                {boundaryOf(p).map((id) => (
                  <use href={`#${shapeId(id)}`} />
                ))}
              </g>
            </g>
          </g>
        ))
      }
    </g>

    <!-- ── Rosa de los vientos ───────────────────────────────────────────── -->
    <g class="compass" transform={`translate(${compass.x}, ${compass.y})`} aria-hidden="true">
      <circle class="compass-disc" cx="0" cy="0" r="19"></circle>
      <text class="compass-n" x="0" y="-3" text-anchor="middle">N</text>
      <polygon class="compass-needle" points="0,-2 -2.6,7 0,5 2.6,7"></polygon>
    </g>

    <!-- ── Escala gráfica ────────────────────────────────────────────────── -->
    <g class="scale" transform={`translate(${scaleBar.x}, ${scaleBar.y})`} aria-hidden="true">
      <rect class="scale-tick" x="0" y="0" width={scaleBarWidth / 2} height="3.5"></rect>
      <rect
        class="scale-tick scale-tick--light"
        x={scaleBarWidth / 2}
        y="0"
        width={scaleBarWidth / 2}
        height="3.5"></rect>
      <text class="scale-label" x="0" y="-5" text-anchor="start">0</text>
      <text class="scale-label" x={scaleBarWidth} y="-5" text-anchor="end">{scaleBar.km} km</text>
    </g>
  </svg>
</div>

<style>
  /* ── Contenedor ─────────────────────────────────────────────────────────── */
  .map-root {
    position: relative;
    width: 100%;
    max-width: 560px;
    margin: 0 auto 0 0;
    user-select: none;
  }

  .canton-svg {
    width: 100%;
    height: auto;
    display: block;
    /* Reserva el hueco antes de pintar: sin salto de layout (CLS) */
    aspect-ratio: var(--map-aspect);
    overflow: visible;
  }

  /* ── Sombra del cantón ──────────────────────────────────────────────────── */
  .map-shadow {
    fill: #063;
    pointer-events: none;
    filter: drop-shadow(2px 4px 16px rgb(7 73 35 / 0.61));
  }

  /* ── Parroquia ──────────────────────────────────────────────────────────── */
  .parish-zone {
    cursor: pointer;
    /* Suprime el rectángulo de foco nativo sobre <g tabindex> */
    outline: none;
    transition:
      opacity 0.22s ease,
      filter 0.22s ease;
  }

  /* El trazo va al doble del ancho del diseño (2) porque la máscara se queda con
     la mitad de tierra adentro: lo que se ve son las 2 unidades del original. */
  .parish-fill {
    stroke: #fff;
    stroke-width: 4;
    stroke-miterlimit: 10;
  }

  /* Foto del diseño: textura tenue bajo el degradado */
  .parish-texture {
    opacity: 0.24;
    pointer-events: none;
  }

  /* Viñeta ilustrada del diseño, sobre el rótulo */
  .parish-icon {
    pointer-events: none;
  }

  .parish-label {
    fill: #fff;
    font-family: 'Space Grotesk', 'Inter', sans-serif;
    font-size: var(--label-size);
    font-weight: 700;
    letter-spacing: 0.01em;
    pointer-events: none;
  }

  /* ── Anillo de realce (hover / foco) ────────────────────────────────────── */
  /* Enmascarado con el resto del cuerpo: se dibuja centrado en el contorno pero
     solo sobrevive la mitad de tierra adentro, así que engordarlo nunca invade al
     vecino. Por eso los grosores van al doble del ancho que se quiere ver. */
  .parish-ring,
  .parish-ring-glow {
    fill: none;
    stroke-width: 0;
    pointer-events: none;
    transition: stroke-width 0.22s ease;
  }
  .parish-ring {
    stroke: #fff;
  }
  .parish-ring-glow {
    stroke: var(--pc);
    filter: blur(4px);
  }

  .parish-zone:hover .parish-ring,
  .parish-zone:focus-visible .parish-ring {
    stroke-width: 7;
  }
  .parish-zone:hover .parish-ring-glow,
  .parish-zone:focus-visible .parish-ring-glow {
    stroke-width: 18;
  }

  /* Foco de teclado: se distingue del hover con el trazo en verde de marca. */
  .parish-zone:focus-visible .parish-ring {
    stroke: var(--color-brand-dark);
    stroke-width: 10;
  }

  .parish-zone:hover,
  .parish-zone:focus-visible {
    filter: brightness(1.1) saturate(1.08);
  }

  /* ── Halo de la seleccionada ────────────────────────────────────────────── */
  .halo-layer {
    pointer-events: none;
  }

  .parish-halo {
    opacity: 0;
    transition: opacity 0.24s ease;
  }
  .parish-halo.active {
    opacity: 1;
    /* Doble resplandor: uno corto que perfila y otro largo que tiñe el aire
       alrededor. Va en el grupo de fuera, sobre el anillo ya enmascarado, así que
       el brillo puede desbordar hacia el vecino aunque el anillo no. */
    filter: drop-shadow(0 0 4px var(--pc)) drop-shadow(0 0 14px var(--pc));
  }

  .halo-ring,
  .halo-glow {
    fill: none;
    stroke-miterlimit: 10;
  }
  /* Filo nítido: 10 de trazo ⇒ 5 unidades vistas tras la máscara. */
  .halo-ring {
    stroke: #fff;
    stroke-width: 10;
  }
  /* Y por dentro, el color de la parroquia encendido contra el filo. */
  .halo-glow {
    stroke: var(--pc);
    stroke-width: 34;
    filter: blur(7px);
  }

  /* ── Rosa de los vientos y escala ───────────────────────────────────────── */
  .compass-disc {
    fill: #fff;
    fill-opacity: 0.88;
    stroke: color-mix(in srgb, var(--color-brand-dark) 22%, transparent);
    stroke-width: 1.2;
  }
  .compass-n {
    fill: var(--color-brand-dark);
    font-family: 'Space Grotesk', 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 700;
  }
  .compass-needle {
    fill: var(--color-brand-secondary);
  }

  .scale-tick {
    fill: var(--color-brand-dark);
    fill-opacity: 0.5;
  }
  .scale-tick--light {
    fill-opacity: 0.18;
  }
  .scale-label {
    fill: color-mix(in srgb, var(--color-brand-dark) 70%, transparent);
    font-family: 'Inter', sans-serif;
    font-size: 13px;
  }

  /* ── Seleccionada ── */
  .parish-zone.active {
    filter: brightness(1.06);
  }

  /* Con una parroquia elegida, las demás ceden protagonismo — y muy poco basta:
     ahora quien destaca es el halo, no el contraste contra las vecinas. Atenuar
     más las volvía pardas (el degradado del diseño se apaga rápido) y dejaba el
     rótulo blanco sin fondo contra el que leerse. */
  .canton-svg:has(.parish-zone.active) .parish-zone:not(.active) {
    opacity: 0.88;
    filter: saturate(0.82);
  }
  .canton-svg:has(.parish-zone.active) .parish-zone:not(.active):hover,
  .canton-svg:has(.parish-zone.active) .parish-zone:not(.active):focus-visible {
    opacity: 1;
    filter: brightness(1.1) saturate(1.08);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .map-root {
      max-width: 100%;
      margin: 0 auto;
    }
    /* En pantallas pequeñas el rótulo del mapa compite con el trazo: se engorda */
    .parish-label {
      font-size: calc(var(--label-size) * 1.12);
    }
  }

  /* Reducir movimiento */
  @media (prefers-reduced-motion: reduce) {
    .parish-zone,
    .parish-ring,
    .parish-ring-glow,
    .parish-halo {
      transition: none;
    }
  }
</style>
