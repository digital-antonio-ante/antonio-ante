---
/**
 * CantonMapSVG.astro — Mapa interactivo del Cantón Antonio Ante.
 *
 * El SVG del diseñador ("Mapa antonio ante.svg") trae las 6 parroquias como
 * paths vectoriales reales, así que aquí NO hay capa de polígonos aproximados:
 * **el contorno que se pinta es el mismo que recibe el clic**. Un solo path por
 * parroquia hace de relleno, de borde, de zona clicable y de recorte de su foto.
 *
 * La geometría y los degradados vienen de `canton-map-geometry.ts` (generado por
 * `scripts/build-canton-map.mjs`); las fotos de fondo, de /images/mapa/*.webp —
 * fuera del SVG, porque incrustadas en base64 pesaban 5,7 MB en el elemento LCP
 * de la home.
 *
 * El JS de canton-hero.ts / canton-map-widget.ts detecta `data-select-parish`
 * — mismo contrato que antes, sin cambios.
 */
import { PARISHES } from '../data/parishes';
import {
  MAP_VIEWBOX,
  MAP_ASPECT_RATIO,
  MAP_UNITS_PER_KM,
  MAP_GRADIENTS,
  PARISH_GEOMETRY,
} from '../data/canton-map-geometry';

/** Prefijo de ids: el SVG va incrustado en el HTML y sus ids son globales. */
const UID = 'aa-map';

const [vbX, vbY, vbW, vbH] = MAP_VIEWBOX.split(' ').map(Number);

/**
 * NO reordenar `PARISH_GEOMETRY`. Los contornos del diseño se solapan en varias
 * zonas (comprobado: reordenarlos mueve ~0,3 % de los píxeles del mapa, en
 * manchas macizas, no en los bordes). El orden del archivo del diseñador decide
 * qué parroquia queda encima en cada solape y, como el path pintado es el mismo
 * que recibe el clic, también decide cuál se lleva la pulsación. Respetarlo es lo
 * que mantiene alineado lo que se ve con lo que se selecciona.
 *
 * Efecto colateral asumido: el orden de tabulación es el del diseño, no el de la
 * tira de tarjetas. Cada zona lleva su aria-label, así que sigue siendo navegable.
 */

/** Rosa de los vientos y escala gráfica, sobre el margen libre del lienzo. */
const compass = { x: vbX + vbW * 0.06, y: vbY + vbH * 0.06 };
const scaleBar = { x: vbX + vbW * 0.03, y: vbY + vbH * 0.965, km: 2 };
const scaleBarWidth = scaleBar.km * MAP_UNITS_PER_KM;
---

<div class="map-root" style={`--map-aspect: ${MAP_ASPECT_RATIO};`}>
  <svg
    class="canton-svg"
    viewBox={MAP_VIEWBOX}
    preserveAspectRatio="xMidYMid meet"
    xmlns="http://www.w3.org/2000/svg"
    role="group"
    aria-label="Mapa del Cantón Antonio Ante — sus seis parroquias son seleccionables"
  >
    <defs>
      <!-- Degradados de relleno del diseño original -->
      {
        MAP_GRADIENTS.map((g) => (
          <linearGradient
            id={`${UID}-grad-${g.id}`}
            x1={g.x1}
            y1={g.y1}
            x2={g.x2}
            y2={g.y2}
            gradientUnits="userSpaceOnUse"
          >
            {g.stops.map((s) => (
              <stop offset={s.offset} stop-color={s.color} />
            ))}
          </linearGradient>
        ))
      }

      {
        PARISH_GEOMETRY.map((p) => (
          <>
            {/* La foto se recorta contra el propio contorno de la parroquia */}
            <clipPath id={`${UID}-clip-${p.id}`}>
              <path d={p.d} />
            </clipPath>
            {/* Sombra proyectada del rótulo — color propio de cada parroquia */}
            <filter id={`${UID}-shadow-${p.id}`} x="-25%" y="-25%" width="150%" height="150%">
              <feOffset dx="2" dy="4" />
              <feGaussianBlur result="blur" stdDeviation="2" />
              <feFlood flood-color={p.shadowColor} flood-opacity="0.61" />
              <feComposite in2="blur" operator="in" />
              <feComposite in="SourceGraphic" />
            </filter>
          </>
        ))
      }
    </defs>

    <!-- ── Una parroquia = un grupo clicable ─────────────────────────────── -->
    {
      PARISH_GEOMETRY.map((p) => {
        const parish = PARISHES[p.id];
        return (
          <g
            class="parish-zone"
            data-select-parish={p.id}
            style={`--pc: ${parish.color};`}
            role="button"
            tabindex="0"
            aria-label={`Seleccionar parroquia ${parish.name}`}
          >
            <path class="parish-fill" d={p.d} fill={`url(#${UID}-grad-${p.gradientId})`} />
            {/* El recorte va en el <g>, NO en el <image>: clipPathUnits es
                userSpaceOnUse y aplicarlo al <image> lo sometería al transform
                de éste, con lo que la foto se saldría del contorno. */}
            <g clip-path={`url(#${UID}-clip-${p.id})`} aria-hidden="true">
              <image
                class="parish-texture"
                href={p.texture.src}
                width={p.texture.width}
                height={p.texture.height}
                transform={p.texture.transform}
              />
            </g>
            <text
              class="parish-label"
              x={p.label.x}
              y={p.label.y}
              text-anchor="middle"
              filter={`url(#${UID}-shadow-${p.id})`}
              aria-hidden="true"
            >
              {p.label.lines.map((line, i) => (
                <tspan x={p.label.x} dy={i === 0 ? 0 : 20.44}>
                  {line}
                </tspan>
              ))}
            </text>
          </g>
        );
      })
    }

    <!-- ── Rosa de los vientos ───────────────────────────────────────────── -->
    <g class="compass" transform={`translate(${compass.x}, ${compass.y})`} aria-hidden="true">
      <circle class="compass-disc" cx="0" cy="0" r="19"></circle>
      <text class="compass-n" x="0" y="-3" text-anchor="middle">N</text>
      <polygon class="compass-needle" points="0,-2 -2.6,7 0,5 2.6,7"></polygon>
    </g>

    <!-- ── Escala gráfica ────────────────────────────────────────────────── -->
    <g class="scale" transform={`translate(${scaleBar.x}, ${scaleBar.y})`} aria-hidden="true">
      <rect class="scale-tick" x="0" y="0" width={scaleBarWidth / 2} height="3.5"></rect>
      <rect
        class="scale-tick scale-tick--light"
        x={scaleBarWidth / 2}
        y="0"
        width={scaleBarWidth / 2}
        height="3.5"></rect>
      <text class="scale-label" x="0" y="-5" text-anchor="start">0</text>
      <text class="scale-label" x={scaleBarWidth} y="-5" text-anchor="end">{scaleBar.km} km</text>
    </g>
  </svg>
</div>

<style>
  /* ── Contenedor ─────────────────────────────────────────────────────────── */
  .map-root {
    position: relative;
    width: 100%;
    max-width: 560px;
    margin: 0 auto 0 0;
    user-select: none;
  }

  .canton-svg {
    width: 100%;
    height: auto;
    display: block;
    /* Reserva el hueco antes de pintar: sin salto de layout (CLS) */
    aspect-ratio: var(--map-aspect);
    overflow: visible;
  }

  /* ── Parroquia ──────────────────────────────────────────────────────────── */
  .parish-zone {
    cursor: pointer;
    /* Suprime el rectángulo de foco nativo sobre <g tabindex> */
    outline: none;
    transition:
      opacity 0.22s ease,
      filter 0.22s ease;
  }

  .parish-fill {
    stroke: #fff;
    stroke-width: 2;
    stroke-miterlimit: 10;
    transition: stroke-width 0.22s ease;
  }

  /* Foto del diseño: textura tenue bajo el degradado */
  .parish-texture {
    opacity: 0.24;
    pointer-events: none;
  }

  .parish-label {
    fill: #fff;
    font-family: 'Space Grotesk', 'Inter', sans-serif;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.01em;
    pointer-events: none;
  }

  /* ── Hover / foco ── */
  .parish-zone:hover,
  .parish-zone:focus-visible {
    filter: brightness(1.12) saturate(1.08) drop-shadow(0 0 9px var(--pc));
  }
  .parish-zone:hover .parish-fill {
    stroke-width: 4;
  }

  /* Foco de teclado: borde verde oscuro en lugar del blanco. Se distingue del
     hover y contrasta tanto con el relleno de la parroquia como con el fondo. */
  .parish-zone:focus-visible .parish-fill {
    stroke: var(--color-brand-dark);
    stroke-width: 6;
  }

  /* ── Rosa de los vientos y escala ───────────────────────────────────────── */
  .compass-disc {
    fill: #fff;
    fill-opacity: 0.88;
    stroke: color-mix(in srgb, var(--color-brand-dark) 22%, transparent);
    stroke-width: 1.2;
  }
  .compass-n {
    fill: var(--color-brand-dark);
    font-family: 'Space Grotesk', 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 700;
  }
  .compass-needle {
    fill: var(--color-brand-secondary);
  }

  .scale-tick {
    fill: var(--color-brand-dark);
    fill-opacity: 0.5;
  }
  .scale-tick--light {
    fill-opacity: 0.18;
  }
  .scale-label {
    fill: color-mix(in srgb, var(--color-brand-dark) 70%, transparent);
    font-family: 'Inter', sans-serif;
    font-size: 13px;
  }

  /* ── Seleccionada ── */
  .parish-zone.active {
    filter: brightness(1.06) drop-shadow(0 0 12px var(--pc));
  }
  .parish-zone.active .parish-fill {
    stroke-width: 5;
  }

  /* Con una parroquia elegida, las demás ceden protagonismo — sin pasarse: el
     rótulo va en blanco sobre el relleno, así que atenuar de más lo vuelve
     ilegible. 0,7 basta para que la seleccionada destaque. */
  .canton-svg:has(.parish-zone.active) .parish-zone:not(.active) {
    opacity: 0.7;
    filter: saturate(0.65);
  }
  .canton-svg:has(.parish-zone.active) .parish-zone:not(.active):hover,
  .canton-svg:has(.parish-zone.active) .parish-zone:not(.active):focus-visible {
    opacity: 1;
    filter: brightness(1.12) saturate(1.08) drop-shadow(0 0 9px var(--pc));
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .map-root {
      max-width: 100%;
      margin: 0 auto;
    }
    /* En pantallas pequeñas el rótulo del mapa compite con el trazo: se engorda */
    .parish-label {
      font-size: 19px;
    }
  }

  /* Reducir movimiento */
  @media (prefers-reduced-motion: reduce) {
    .parish-zone,
    .parish-fill {
      transition: none;
    }
  }
</style>
