---
/**
 * EventoImagen.astro — Imagen de evento que rellena su contenedor sin pixelarse.
 *
 * Casi todas las imágenes de eventos son flyers cuadrados o verticales y
 * pequeños. Recortarlos a un hueco apaisado corta su texto y los amplía hasta
 * pixelarlos. Así que:
 *   - si la imagen ya tiene la forma del hueco (±20 %) → la recorta alrededor
 *     del punto focal elegido en el Studio (hotspot);
 *   - si no → la muestra COMPLETA, a su tamaño como máximo, sobre una versión
 *     desenfocada de sí misma que llena el resto del hueco.
 *
 * El contenedor (padre) define el tamaño; este componente lo ocupa entero.
 */
import {
  srcsetCompleta,
  srcsetRecorte,
  srcDeRespaldo,
  urlFondoDifuso,
  type Dimensiones,
  type PuntoFocal,
} from '@shared/utils/imagen-sanity';

interface Props {
  url: string;
  dims?: Dimensiones | null;
  foco?: PuntoFocal | null;
  alt: string;
  /** Proporción ancho/alto del hueco. */
  proporcion: number;
  sizes: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const { url, dims, foco, alt, proporcion, sizes, loading = 'lazy', class: className } = Astro.props;

const proporcionImg = dims ? dims.width / dims.height : null;
const encaja = proporcionImg !== null && Math.abs(proporcionImg / proporcion - 1) < 0.2;
const srcset = encaja ? srcsetRecorte(url, proporcion, dims, foco) : srcsetCompleta(url, dims);
---

<div class:list={['evi', !encaja && 'evi--flyer', className]}>
  {
    !encaja && (
      <img class="evi__fondo" src={urlFondoDifuso(url)} alt="" aria-hidden="true" {loading} />
    )
  }
  <img
    class="evi__img"
    src={srcDeRespaldo(srcset)}
    {srcset}
    {sizes}
    {alt}
    {loading}
    fetchpriority={loading === 'eager' ? 'high' : 'auto'}
    decoding="async"
    width={dims?.width}
    height={dims?.height}
    style={!encaja && dims
      ? `max-width: ${dims.width}px; max-height: ${dims.height}px;`
      : undefined}
  />
</div>

<style>
  .evi {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .evi__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .evi--flyer .evi__img {
    position: relative;
    object-fit: contain;
  }
  .evi__fondo {
    position: absolute;
    inset: -12%;
    width: 124%;
    height: 124%;
    /* El reset global (img { max-width: 100% }) lo cortaría y dejaría el borde derecho sin fondo. */
    max-width: none;
    object-fit: cover;
    filter: blur(16px) saturate(1.15) brightness(0.85);
  }
</style>
