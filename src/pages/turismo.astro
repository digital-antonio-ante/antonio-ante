---
export const prerender = true;

import BaseLayout from '@ui/BaseLayout.astro';
import { getConfigSitio } from '@api/endpoints/config-sitio';
import { ALTITUD_CANTON_M, fmt } from '@shared/config/canton';

// La misma foto panorámica del cantón que usa el panel de la home (Sanity).
const config = await getConfigSitio().catch(() => null);
const heroImg = config?.cantonImageUrl ?? null;
const heroImgAlt = config?.cantonImageAlt ?? 'Vista del cantón Antonio Ante';
const altitud = `${fmt(ALTITUD_CANTON_M)} m s. n. m.`;

// Solo atractivos con respaldo público (Municipio, Ministerio de Cultura,
// PDOT parroquiales, prensa) — ver el comentario de `parishes.ts`.
const atractivos = [
  {
    nombre: 'Expo Atuntaqui',
    categoria: 'Moda',
    descripcion:
      'Cada Carnaval, más de 160 expositores, desfiles y patio gastronómico en el centro de Atuntaqui. El resto del año, más de 150 almacenes de ropa hecha en el cantón.',
    emoji: '🧵',
    href: '/parroquias/atuntaqui/',
    color: 'bg-blue-50 border-blue-200',
    accentColor: 'text-blue-700',
  },
  {
    nombre: 'Fábrica Imbabura',
    categoria: 'Patrimonio',
    descripcion:
      'Construida en 1924 en Andrade Marín, es el único Patrimonio Cultural Industrial del Ecuador. Hoy es complejo cultural y museo, con entrada gratuita.',
    emoji: '🏭',
    href: '/parroquias/andrade-marin/',
    color: 'bg-amber-50 border-amber-200',
    accentColor: 'text-amber-700',
  },
  {
    nombre: 'Tren Tayta Imbabura',
    categoria: 'Experiencia',
    descripcion:
      'Sale de Ibarra y termina en la antigua Fábrica Imbabura: la forma más bonita de llegar a Andrade Marín. Consulta los horarios antes de viajar.',
    emoji: '🚂',
    href: '/parroquias/andrade-marin/',
    color: 'bg-teal-50 border-teal-200',
    accentColor: 'text-teal-700',
  },
  {
    nombre: 'Chaltura, capital del cuy',
    categoria: 'Gastronomía',
    descripcion:
      'Cuy frito en paila con papas, tostado, mote y choclo, en la ruta del cuy y el Complejo La Hornilla.',
    emoji: '🍽️',
    href: '/parroquias/chaltura/',
    color: 'bg-red-50 border-red-200',
    accentColor: 'text-red-700',
  },
  {
    nombre: 'Inti Raymi',
    categoria: 'Cultura viva',
    descripcion:
      'En junio, Natabuela y las comunidades de San Roque celebran la Fiesta del Sol con danzas, música y chicha de jora.',
    emoji: '☀️',
    href: '/parroquias/natabuela/',
    color: 'bg-purple-50 border-purple-200',
    accentColor: 'text-purple-700',
  },
  {
    nombre: 'Tejidos de San Roque',
    categoria: 'Artesanía',
    descripcion:
      'Tapices de cabuya tejidos en telares de madera, ponchos y chalinas de lana, en las faldas del Imbabura.',
    emoji: '🧶',
    href: '/parroquias/san-roque/',
    color: 'bg-orange-50 border-orange-200',
    accentColor: 'text-orange-700',
  },
];

// Temporadas: las mismas fiestas que el GAD carga en la agenda (Sanity).
const temporadas = [
  {
    cuando: 'Carnaval · febrero',
    que: 'Expo Atuntaqui',
    detalle: 'Moda, desfiles, patio gastronómico y comparsas en el centro de Atuntaqui.',
    emoji: '🧵',
  },
  {
    cuando: 'Marzo',
    que: 'Fiestas de Cantonización',
    detalle: 'Desfile, verbena popular y eventos culturales y deportivos en todo el cantón.',
    emoji: '🎉',
  },
  {
    cuando: 'Junio',
    que: 'Inti Raymi',
    detalle: 'La Fiesta del Sol con danzas, música y tradición en San Roque y Natabuela.',
    emoji: '☀️',
  },
  {
    cuando: '27 dic – 7 ene',
    que: 'Inocentes y Fin de Año',
    detalle:
      'Comparsas y disfrazados llenan Atuntaqui en una fiesta declarada Patrimonio Cultural Inmaterial.',
    emoji: '🎭',
  },
];

interface Estadistica {
  valor: string;
  descripcion: string;
  /** Si está, la cifra sube de 0 a `hasta` al entrar en pantalla. */
  contar?: { hasta: number; prefijo?: string; sufijo?: string };
}
const estadisticas: Estadistica[] = [
  // El Universo, 2025. (La cifra de visitantes de la Expo no tiene fuente publicada.)
  {
    valor: '+150',
    descripcion: 'Almacenes de ropa en Atuntaqui',
    contar: { hasta: 150, prefijo: '+' },
  },
  { valor: '6', descripcion: 'Parroquias para recorrer', contar: { hasta: 6 } },
  { valor: '1924', descripcion: 'Nace la Fábrica Imbabura, hoy museo' },
  { valor: '~2 h', descripcion: 'Desde Quito en carretera' },
];
---

<BaseLayout
  title="Turismo"
  description="Qué hacer en Antonio Ante, a dos horas de Quito: compras en Atuntaqui, la Fábrica Imbabura y el Tren Tayta Imbabura, cuy en Chaltura, Inti Raymi y tejidos de San Roque."
>
  <!-- Hero editorial -->
  <section class="relative overflow-hidden" aria-labelledby="turismo-heading">
    <!-- Fondo con gradiente -->
    <div
      class="absolute inset-0 bg-gradient-to-br from-blue-950 via-brand-deep to-teal-900"
      aria-hidden="true"
    >
    </div>
    <!-- Patrón textil decorativo -->
    <div class="absolute inset-0 opacity-5" aria-hidden="true">
      <svg width="100%" height="100%">
        <defs>
          <pattern id="textile" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
            <circle cx="2" cy="2" r="1.5" fill="white"></circle>
            <circle cx="14" cy="14" r="1.5" fill="white"></circle>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#textile)"></rect>
      </svg>
    </div>

    <div
      class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28 grid lg:grid-cols-[minmax(0,1fr)_26rem] gap-12 items-center"
    >
      <div>
        <nav aria-label="Breadcrumb" class="mb-6">
          <ol class="flex items-center gap-2 text-white/70 text-sm" role="list">
            <li><a href="/" class="hover:text-white transition-colors">Inicio</a></li>
            <li aria-hidden="true" class="select-none">›</li>
            <li class="text-white font-medium" aria-current="page">Turismo</li>
          </ol>
        </nav>

        <p
          class="inline-flex items-center gap-2 text-brand-primary-soft font-bold text-xs uppercase tracking-widest mb-4"
        >
          <span aria-hidden="true">★</span>
          Imbabura · Ecuador · {altitud}
        </p>

        <h1
          id="turismo-heading"
          class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight tracking-tight mb-6 animate-entrada"
        >
          Descubre<br />
          <span class="text-brand-primary-soft">Antonio Ante</span>
        </h1>

        <p
          class="text-white/80 text-lg lg:text-xl max-w-2xl leading-relaxed mb-10 animate-entrada retardo-1"
        >
          La <strong class="text-white">Capital de la Moda del Ecuador</strong>. Llena la maleta en
          los almacenes de Atuntaqui, almuerza cuy en Chaltura y recorre la fábrica donde empezó
          todo, con el volcán Imbabura de fondo. Todo en menos de 80 km².
        </p>

        <!-- Pills de actividades -->
        <div
          class="flex flex-wrap gap-2 animate-entrada retardo-2"
          aria-label="Tipos de turismo disponibles"
        >
          {
            [
              '🧵 Moda & Textil',
              '🍽️ Gastronomía',
              '🏛️ Patrimonio',
              '🏞️ Naturaleza',
              '🎊 Cultura',
            ].map((pill) => (
              <span class="px-4 py-1.5 bg-white/10 text-white text-sm font-semibold rounded-full border border-white/20">
                {pill}
              </span>
            ))
          }
        </div>
      </div>

      {
        heroImg && (
          <figure class="hidden lg:block m-0 animate-entrada retardo-1">
            <img
              src={`${heroImg}?w=832&h=1040&fit=crop&auto=format&q=80`}
              srcset={`${heroImg}?w=416&h=520&fit=crop&auto=format&q=80 416w, ${heroImg}?w=832&h=1040&fit=crop&auto=format&q=80 832w`}
              sizes="26rem"
              alt={heroImgAlt}
              width="416"
              height="520"
              class="w-full aspect-[4/5] object-cover rounded-2xl shadow-2xl ring-1 ring-white/15"
              decoding="async"
            />
          </figure>
        )
      }
    </div>
  </section>

  <!-- Estadísticas -->
  <section class="bg-brand-secondary py-10" aria-label="Datos de turismo">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ul class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center" role="list">
        {
          estadisticas.map(({ valor, descripcion, contar }) => (
            <li>
              <p
                class="text-2xl lg:text-3xl font-bold text-white leading-none mb-1 tabular-nums"
                data-contar={contar?.hasta}
                data-prefijo={contar?.prefijo}
                data-sufijo={contar?.sufijo}
              >
                {valor}
              </p>
              <p class="text-white/80 text-xs font-semibold uppercase tracking-wide">
                {descripcion}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Atractivos -->
  <section class="py-16 lg:py-24 bg-brand-light" aria-labelledby="atractivos-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="text-brand-primary text-xs font-bold uppercase tracking-widest mb-2">
          Qué visitar
        </p>
        <h2
          id="atractivos-heading"
          class="font-display text-2xl lg:text-3xl font-bold text-brand-primary"
        >
          Principales atractivos
        </h2>
        <p class="text-brand-dark/60 mt-3 max-w-xl mx-auto">
          Seis planes en el cantón más pequeño de Imbabura: todo queda a minutos.
        </p>
      </div>

      <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" role="list">
        {
          atractivos.map(({ nombre, categoria, descripcion, emoji, href, color, accentColor }) => (
            <li>
              <a
                href={href}
                class:list={[
                  'flex h-full items-start gap-4 rounded-xl border p-6 transition duration-200 hover:-translate-y-0.5 hover:shadow-md',
                  color,
                ]}
              >
                <span class="text-3xl flex-shrink-0" aria-hidden="true">
                  {emoji}
                </span>
                <div>
                  <p class:list={['text-xs font-bold uppercase tracking-widest mb-1', accentColor]}>
                    {categoria}
                  </p>
                  <h3 class="font-bold text-brand-dark text-base mb-2">{nombre}</h3>
                  <p class="text-sm text-brand-dark/65 leading-relaxed">{descripcion}</p>
                  <p class:list={['text-sm font-semibold mt-3', accentColor]}>Ver más →</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Cuándo venir: las fechas salen de la agenda real del cantón -->
  <section
    class="py-16 lg:py-20 bg-white border-t border-gray-100"
    aria-labelledby="cuando-heading"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <p class="text-brand-primary text-xs font-bold uppercase tracking-widest mb-2">
          Calendario
        </p>
        <h2
          id="cuando-heading"
          class="font-display text-2xl lg:text-3xl font-bold text-brand-primary"
        >
          Cuándo venir
        </h2>
        <p class="text-brand-dark/60 mt-3 max-w-xl mx-auto">
          Cualquier fin de semana es bueno para comprar y comer bien. Estas fechas, además, llenan
          las calles de fiesta.
        </p>
      </div>
      <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" role="list">
        {
          temporadas.map(({ cuando, que, detalle, emoji }) => (
            <li class="rounded-xl border border-gray-100 bg-brand-light p-5">
              <p class="text-xs font-bold uppercase tracking-widest text-brand-secondary mb-2">
                <span aria-hidden="true">{emoji}</span> {cuando}
              </p>
              <h3 class="font-bold text-brand-dark mb-1">{que}</h3>
              <p class="text-sm text-brand-dark/65 leading-relaxed">{detalle}</p>
            </li>
          ))
        }
      </ol>
      <p class="text-center mt-8">
        <a
          href="/eventos/"
          class="inline-flex items-center gap-2 text-sm font-semibold text-brand-primary hover:underline"
        >
          Ver fechas exactas en la agenda →
        </a>
      </p>
    </div>
  </section>

  <!-- Cómo llegar -->
  <section
    id="como-llegar"
    class="py-16 bg-brand-accent border-t border-gray-100 scroll-mt-20"
    aria-labelledby="llegar-heading"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-brand-primary text-xs font-bold uppercase tracking-widest mb-2">
            Accesibilidad
          </p>
          <h2
            id="llegar-heading"
            class="font-display text-2xl lg:text-3xl font-bold text-brand-primary mb-4"
          >
            Cómo llegar
          </h2>
          <p class="text-brand-dark/70 mb-6">
            Atuntaqui se encuentra a <strong class="text-brand-dark">~100 km</strong> al norte de Quito
            por la Panamericana Norte (E35). El viaje dura aproximadamente <strong
              class="text-brand-dark">2 horas</strong
            >, según el tráfico.
          </p>
          <ul class="space-y-3 text-sm" role="list">
            {
              [
                { desde: 'Quito', tiempo: '~2 h', via: 'Panamericana Norte (E35)' },
                { desde: 'Ibarra', tiempo: '~15 min', via: 'E35 sur' },
                { desde: 'Otavalo', tiempo: '~20 min', via: 'E35 norte' },
                { desde: 'Tulcán', tiempo: '~2 h 30 min', via: 'Panamericana (E35)' },
              ].map(({ desde, tiempo, via }) => (
                <li class="flex items-start gap-3">
                  <svg
                    class="w-4 h-4 text-brand-primary flex-shrink-0 mt-0.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"
                    />
                  </svg>
                  <div>
                    <span class="font-semibold text-brand-dark">Desde {desde}</span>
                    <span class="text-brand-dark/60">
                      {' '}
                      — {tiempo} vía {via}
                    </span>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="bg-white rounded-xl border border-gray-100 p-6">
          <h3 class="font-bold text-brand-primary mb-4 text-base">Antes de venir</h3>
          <dl class="grid grid-cols-2 gap-4 text-sm mb-4">
            <div>
              <dt class="text-brand-dark/50 font-medium">Clima</dt>
              <dd class="text-brand-dark font-semibold">14–22 °C, templado todo el año</dd>
            </div>
            <div>
              <dt class="text-brand-dark/50 font-medium">Qué llevar</dt>
              <dd class="text-brand-dark font-semibold">Abrigo para la noche y protector solar</dd>
            </div>
            <div>
              <dt class="text-brand-dark/50 font-medium">Altitud</dt>
              <dd class="text-brand-dark font-semibold">{altitud}</dd>
            </div>
            <div>
              <dt class="text-brand-dark/50 font-medium">Desde Ibarra</dt>
              <dd class="text-brand-dark font-semibold">A 15 minutos</dd>
            </div>
          </dl>
          <a
            href="https://maps.google.com/?q=Atuntaqui,+Ecuador"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 bg-brand-primary text-white text-sm font-semibold rounded-lg hover:opacity-90 transition-opacity outline-none focus-visible:ring-2 focus-visible:ring-brand-primary focus-visible:ring-offset-2"
            aria-label="Ver Atuntaqui en Google Maps (abre en nueva pestaña)"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              ></path>
            </svg>
            Abrir en Google Maps
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <section class="py-16 bg-brand-primary text-white" aria-label="Planifica tu visita">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-2xl lg:text-3xl font-bold mb-4">Arma tu plan</h2>
      <p class="text-white/80 max-w-xl mx-auto mb-8">
        Mira qué hay en la agenda y elige por dónde empezar: compras en Atuntaqui, historia en
        Andrade Marín o cocina tradicional en Chaltura.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/eventos/"
          class="inline-flex items-center gap-2 px-6 py-3 bg-brand-secondary text-white font-semibold rounded-lg hover:opacity-90 transition-opacity outline-none focus-visible:ring-2 focus-visible:ring-brand-secondary focus-visible:ring-offset-2 focus-visible:ring-offset-brand-primary"
        >
          Ver la agenda
        </a>
        <a
          href="/parroquias/"
          class="inline-flex items-center gap-2 px-6 py-3 border-2 border-white/60 text-white font-semibold rounded-lg hover:border-white hover:bg-white/10 transition-colors outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-brand-primary"
        >
          Elige tu parroquia
        </a>
      </div>
      <p class="text-white/70 text-sm mt-6">
        ¿Tienes una duda puntual?
        <a href="/contacto/" class="underline hover:text-white">Escríbenos</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  import { iniciarContadores } from '@shared/utils/contadores';
  iniciarContadores();
</script>
