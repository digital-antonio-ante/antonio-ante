---
// Prerenderizada: HTML estático generado en build (los datos de Sanity se
// consultan una sola vez al construir, no en cada request). El webhook de Sanity
// dispara un redeploy al publicar contenido. Elimina el TTFB del SSR por request.
// Lo único que caduca sin que nadie publique son los eventos: el script del
// final retira en el navegador los que ya terminaron (ver `data-fin`).
export const prerender = true;

import BaseLayout from '@ui/BaseLayout.astro';
import CantonHero from '../modules/canton/ui/CantonHero.astro';
import ImpactCounters from '../modules/obras/ui/ImpactCounters.astro';
import ObrasGrid from '../modules/obras/ui/ObrasGrid.astro';
import ObraDestacada from '../modules/obras/ui/ObraDestacada.astro';
import EventoDestacado from '../modules/eventos/ui/EventoDestacado.astro';
import EventoCard from '../modules/eventos/ui/EventoCard.astro';
import { getObrasRecientes, getObraDestacada } from '@api/endpoints/obras';
import { getEventoDestacado, getEventosProximos } from '@api/endpoints/eventos';
import { getConfigSitio } from '@api/endpoints/config-sitio';
import { OBRAS_HABILITADAS } from '@shared/config/features';

// La imagen del panel del cantón es el elemento LCP de la home. Como la página es
// estática, conocemos su URL en build y podemos precargarla en el <head> con la
// misma srcset/sizes que el <img> — así el navegador la descarga de inmediato en
// lugar de esperar a parsear el DOM hasta el panel. Baja el LCP en escritorio.
const configHome = await getConfigSitio().catch(() => null);
const cantonImgBase = configHome?.cantonImageUrl
  ? `${configHome.cantonImageUrl}${configHome.cantonImageUrl.includes('?') ? '&' : '?'}`
  : null;
const heroPreloadHref = cantonImgBase
  ? `${cantonImgBase}w=800&h=480&fit=crop&auto=format&q=72`
  : null;
const heroPreloadSrcset = cantonImgBase
  ? `${cantonImgBase}w=400&h=240&fit=crop&auto=format&q=72 400w, ${cantonImgBase}w=800&h=480&fit=crop&auto=format&q=72 800w`
  : null;

const [obras, obraDestacada, eventoDestacado, eventosProximos] = await Promise.all([
  OBRAS_HABILITADAS
    ? getObrasRecientes(6).catch((err) => {
        console.error('[ObrasGrid]', err?.message ?? err);
        return [];
      })
    : Promise.resolve([]),
  OBRAS_HABILITADAS
    ? getObraDestacada().catch((err) => {
        console.error('[ObraDestacada]', err?.message ?? err);
        return null;
      })
    : Promise.resolve(null),
  getEventoDestacado().catch((err) => {
    console.error('[EventoDestacado]', err?.message ?? err);
    return null;
  }),
  // Más de los 3 visibles: si alguno caduca antes del próximo build, el
  // siguiente ocupa su lugar (la regla CSS `li:nth-child(n + 4)` los oculta).
  getEventosProximos(6).catch((err) => {
    console.error('[EventosProximos]', err?.message ?? err);
    return [];
  }),
]);

// Excluir el destacado del strip de próximos (ya tiene su propia sección)
const eventosStrip = eventosProximos.filter((e) => e._id !== eventoDestacado?._id);
---

<BaseLayout
  title="Inicio"
  description="Antonio Ante, Imbabura: la Capital de la Moda del Ecuador, a dos horas de Quito. Más de 150 almacenes de ropa, cuy en Chaltura, la Fábrica Imbabura hecha museo y la agenda de ferias y fiestas."
>
  {
    heroPreloadHref && (
      <link
        slot="head"
        rel="preload"
        as="image"
        href={heroPreloadHref}
        imagesrcset={heroPreloadSrcset}
        imagesizes="(max-width: 768px) 100vw, 400px"
        fetchpriority="high"
      />
    )
  }

  <!-- ─── Hero — Mapa interactivo + Panel de parroquias ────────────────────── -->
  <CantonHero />

  {
    OBRAS_HABILITADAS && (
      <Fragment>
        <!-- ─── Cifras de impacto (sección dark animada) ─────────────────────── -->
        <div style="margin-top: 2.5rem;">
          <ImpactCounters />
        </div>

        <!-- ─── Obra destacada del período ───────────────────────────────────── -->
        <ObraDestacada obra={obraDestacada} />

        <!-- ─── Obras en marcha ───────────────────────────────────────────────── -->
        <ObrasGrid obras={obras} />
      </Fragment>
    )
  }

  <!-- ─── Evento destacado ─────────────────────────────────────────────────── -->
  <EventoDestacado evento={eventoDestacado} />

  <!-- ─── Próximos eventos ─────────────────────────────────────────────────── -->
  {
    eventosStrip.length > 0 && (
      <section class="eventos-strip" aria-labelledby="eventos-heading">
        <div class="eventos-strip-inner">
          <div class="eventos-strip-header">
            <div>
              <p class="eventos-strip-eyebrow">No te lo pierdas</p>
              <h2 id="eventos-heading" class="eventos-strip-title">
                Próximos eventos
              </h2>
            </div>
            <a href="/eventos/" class="eventos-strip-link">
              Ver todos
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
              >
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>
          <ul class="eventos-strip-grid" role="list">
            {eventosStrip.map((evento, i) => (
              <li>
                <EventoCard evento={evento} loading={i < 2 ? 'eager' : 'lazy'} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- ─── Cierre: invitación a venir (no una ficha técnica) ──────────────── -->
  <section class="canton-callout" aria-labelledby="callout-heading">
    <div class="callout-bar" aria-hidden="true"></div>

    <div class="callout-inner">
      <div class="callout-text">
        <p class="callout-eyebrow">Planifica tu visita</p>
        <h2 id="callout-heading" class="callout-title">Ven este fin de semana.</h2>
        <p class="callout-sub">
          Antonio Ante está a unas dos horas de Quito por la Panamericana Norte y a 15 minutos de
          Ibarra. Elige tu plan:
        </p>
      </div>

      <ul class="callout-metrics" role="list" aria-label="Planes para tu visita">
        {
          [
            { icono: '🚗', num: '~2 h', label: 'Desde Quito', detail: 'Cómo llegar', href: '/turismo/#como-llegar' },
            { icono: '🧵', num: 'Compras', label: 'Atuntaqui', detail: 'Ropa de fábrica', href: '/parroquias/atuntaqui/' },
            { icono: '🍽️', num: 'Cuy', label: 'Chaltura', detail: 'Frito en paila', href: '/parroquias/chaltura/' },
            { icono: '📅', num: 'Agenda', label: 'Eventos', detail: 'Ferias y fiestas', href: '/eventos/' },
          ].map(({ icono, num, label, detail, href }) => (
            <li>
              <a class="callout-metric" href={href}>
                <span class="callout-metric-icon" aria-hidden="true">
                  {icono}
                </span>
                <div>
                  <strong class="callout-metric-num">{num}</strong>
                  <span class="callout-metric-label">{label}</span>
                  <span class="callout-metric-detail">{detail}</span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<script>
  // La home es estática: entre un build y otro, un evento puede terminar.
  // Se retira del DOM con su fecha de fin (data-fin, ISO); al quitarlo, el
  // siguiente de la lista entra en los 3 visibles. Sin tarjetas, se va la sección.
  const ahora = Date.now();
  for (const el of document.querySelectorAll<HTMLElement>('[data-fin]')) {
    if (Date.parse(el.dataset.fin ?? '') < ahora) (el.closest('li') ?? el).remove();
  }
  const strip = document.querySelector('.eventos-strip');
  if (strip && !strip.querySelector('li')) strip.remove();
</script>

<style>
  /* ── Eventos strip ────────────────────────────────────────────────────────── */
  .eventos-strip {
    /* Separación propia: sin evento destacado vigente, la sección queda pegada
       a las tarjetas de parroquia. */
    padding: 3rem 0;
  }
  .eventos-strip-inner {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .eventos-strip-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .eventos-strip-eyebrow {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-brand-primary);
    margin: 0 0 0.35rem;
  }
  .eventos-strip-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.3rem, 2.5vw, 1.75rem);
    font-weight: 800;
    color: var(--color-neutral-900);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0;
  }
  .eventos-strip-link {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-brand-primary);
    text-decoration: none;
    padding: 0.4rem 0.9rem;
    border: 1.5px solid var(--color-brand-primary);
    border-radius: 9999px;
    transition:
      background 0.18s ease,
      color 0.18s ease;
    white-space: nowrap;
  }
  .eventos-strip-link:hover {
    background: var(--color-brand-primary);
    color: #fff;
  }
  .eventos-strip-grid > li:nth-child(n + 4) {
    display: none;
  }
  .eventos-strip-grid {
    display: grid;
    /* minmax(0, …): con `1fr` a secas la columna no baja del ancho mínimo del
       contenido y en móvil la tarjeta se salía 20px por la derecha. */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (max-width: 1024px) {
    .eventos-strip-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .eventos-strip-inner {
      padding: 0 1rem;
    }
    .eventos-strip-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .eventos-strip-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }
  }

  /* ── Canton callout ───────────────────────────────────────────────────────── */
  .canton-callout {
    background: #ffffff;
    border: 1px solid var(--color-neutral-200);
    border-radius: 16px;
    overflow: hidden;
    max-width: 80rem;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    margin: 3rem max(1rem, calc((100% - 80rem) / 2)) 3.5rem;
  }

  .callout-bar {
    height: 4px;
    background: linear-gradient(90deg, #277816 0%, #d97706 55%, #dc2626 100%);
  }

  .callout-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 2rem 2.5rem;
  }

  .callout-text {
    flex: 1;
    min-width: 0;
  }

  .callout-eyebrow {
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-neutral-500);
    margin: 0 0 0.5rem;
  }

  .callout-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 800;
    color: var(--color-neutral-900);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 0.5rem;
  }

  .callout-sub {
    font-size: 0.82rem;
    color: var(--color-neutral-500);
    line-height: 1.6;
    margin: 0;
    max-width: 32rem;
  }

  .callout-metrics {
    display: flex;
    gap: 0.75rem;
    flex-shrink: 0;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .callout-metric {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--color-neutral-50);
    border: 1px solid var(--color-neutral-200);
    border-radius: 12px;
    padding: 0.75rem 1rem;
    min-width: 100px;
    height: 100%;
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .callout-metric:hover {
    transform: translateY(-2px);
    border-color: var(--color-brand-primary);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
  }

  .callout-metric-icon {
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .callout-metric > div {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
  }

  .callout-metric-num {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.1rem;
    font-weight: 800;
    background: linear-gradient(135deg, #277816, #d97706);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
    display: block;
  }

  .callout-metric-label {
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-neutral-500);
    display: block;
  }

  .callout-metric-detail {
    font-size: 0.58rem;
    color: var(--color-neutral-500);
    display: block;
    margin-top: 0.1rem;
  }

  @media (max-width: 768px) {
    .canton-callout {
      margin-top: 0;
      border-radius: 0;
      border-left: none;
      border-right: none;
    }
    .callout-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
      padding: 1.5rem;
    }
    .callout-metrics {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.6rem;
    }
    .callout-metric {
      flex: none;
      min-width: 0;
      padding: 0.65rem 0.75rem;
      gap: 0.45rem;
    }
    .callout-metric-icon {
      font-size: 1.1rem;
    }
    .callout-metric-num {
      font-size: 0.95rem;
    }
  }

  @media (max-width: 480px) {
    .callout-inner {
      padding: 1.25rem;
      gap: 1rem;
    }
    .callout-title {
      font-size: 1.15rem;
    }
    .callout-sub {
      font-size: 0.78rem;
    }
    .callout-metrics {
      gap: 0.5rem;
    }
    .callout-metric {
      padding: 0.55rem 0.65rem;
    }
    .callout-metric-num {
      font-size: 0.88rem;
    }
    .callout-metric-label {
      font-size: 0.55rem;
    }
  }
</style>
